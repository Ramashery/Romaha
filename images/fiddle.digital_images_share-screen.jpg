.-animated-figures.-b::before { animation: 0.75s step-end 0s infinite normal none running specialSymbolB; }

.-tooltip { position: relative; cursor: default; padding: calc(var(--g-gap)/2) var(--g-gap); margin: calc(var(--g-gap)*-1/2) calc(var(--g-gap)*-1); border-radius: var(--m); }

