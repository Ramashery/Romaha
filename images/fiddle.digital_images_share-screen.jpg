.string-cursor { display: none; }

@media (min-width: 1024px) {
  .string-cursor { display: flex; justify-content: flex-start; align-items: flex-start; width: auto; height: auto; position: fixed; z-index: 100; left: 0px; top: 0px; pointer-events: none; will-change: transform; transform: translate3d(calc(1px*var(--x) + 1rem),calc(1px*var(--y) + 1.5rem),0) skew(max(-30deg,min(30deg,-1deg * var(--x-lerp))),max(-30deg,min(30deg,-1deg * var(--y-lerp)))); }
  .string-cursor > * { flex-shrink: 0; }
  .cursor-circle { mix-blend-mode: difference; }
  .cursor-circle::before { content: ""; position: absolute; inset: 0px; display: block; width: 1rem; height: 1rem; border-radius: 50%; background-color: var(--c-white); scale: 0; transition-property: ; transition-duration: ; transition-timing-function: ; transition-behavior: ; transition-delay: 0s; }
  .cursor-circle::after { content: ""; display: block; width: 0.8rem; height: 0.8rem; border-radius: 50%; mask: linear-gradient(rgb(255, 255, 255) 0px, rgb(255, 255, 255) 0px) content-box exclude, linear-gradient(rgb(255, 255, 255) 0px, rgb(255, 255, 255) 0px); padding: 0.1rem; background-image: conic-gradient(from 0deg,var(--c-white) calc(var(--a)),transparent 0); animation: cursorLoadingBack .6s var(--f-smooth) forwards; }
  .cursor-circle.-circle.-show::before { scale: 0.4; transition-property: ; transition-duration: ; transition-timing-function: ; transition-behavior: ; transition-delay: 1.2s; }
  .cursor-circle.-circle.-show::after { animation: cursorLoading 1.2s var(--f-smooth) forwards; }
  .cursor-link { display: grid; place-items: center; }
  .cursor-link svg { grid-area: 1 / 1; width: 1rem; background-color: var(--c-white); fill: var(--c-black); backdrop-filter: blur(0.4rem); padding: 0.2rem; border-radius: 0.4rem; scale: 0.5; opacity: 0; transform-origin: 0px 0px; transition: scale .3s var(--f-cubic),opacity .3s var(--f-cubic); }
  .cursor-link.-project-blank.-show svg.-blank, .cursor-link.-project-route.-show svg.-route { scale: 1; opacity: 1; transition-delay: 0.15s; }
  .cursor-projects .project-imgs { width: calc(var(--vw, 1vw)*100*.28571 - var(--g-margin)*2*.28571 - var(--g-gap)/2); display: grid; place-items: center; }
  .cursor-projects .project-imgs figure { grid-area: 1 / 1; contain: paint; scale: 0; transition: scale .3s var(--f-cubic-in); will-change: transform; }
  .cursor-projects .project-imgs figure img { position: relative; width: 100%; height: 100%; object-fit: cover; scale: 4; transition: scale .3s var(--f-cubic-in); }
  .cursor-projects.-project.-show .project-imgs figure.-active { z-index: 101; background-color: var(--c-black); scale: 1; transition: scale .9s var(--f-fast),transform 75ms ease; }
  .cursor-projects.-project.-show .project-imgs figure.-active img { transform: translate3d(max(-2rem,min(2rem,var(--x-lerp) * -.025rem)),max(-2rem,min(2rem,var(--y-lerp) * -.05rem)),0); scale: 1.25; transition-property: ; transition-duration: ; transition-timing-function: ; transition-behavior: ; transition-delay: 0s; }
}

@property --a { syntax: "<angle>"; inherits: false; initial-value: 0deg; }

@keyframes cursorLoading { 
  0% { --a: 0deg; }
  80% { scale: 1; }
  100% { scale: 0; --a: 360deg; }
}

@keyframes cursorLoadingBack { 
  0% { --a: 360deg; scale: 0; }
  20% { scale: 1; }
