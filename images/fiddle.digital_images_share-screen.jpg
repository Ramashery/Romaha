.-t-splash-leave-active .tt { transform: translate(0px) scale(1); transition: transform linear; }

.-t-splash-leave-active .tt .fd { transition: opacity linear, width linear; }

.-t-splash-leave-active .tt .fd:nth-child(2) { transform: translate3d(0px, 100%, 0px); transition: transform .3s var(--f-fast),opacity 0s linear,width 0s linear; }

.-t-splash-leave-active .tt .fd:nth-child(4) { transform: scale(2); transition: transform .6s var(--f-fast),opacity 0s linear,width 0s linear; }

.-t-splash-leave-to::before { opacity: 0; transition-delay: 0.3s; }

.-t-splash-leave-to .tt { transform: translate(-50%) scale(1.5); transition-delay: 0.75s; }

.-t-splash-leave-to .tt .-animated-figures { width: 0px; opacity: 0; transition-delay: 0.225s; }

.-t-splash-leave-to .tt .fd { opacity: 1; width: auto; }

.-t-splash-leave-to .tt .fd:nth-child(2) { transform: translateZ(0px); }

.-t-splash-leave-to .tt .fd:nth-child(3) { transition-delay: 0.3s; }

.-t-splash-leave-to .tt .fd:nth-child(4) { transform: scale(1); transition-delay: 75ms; }

@media (max-width: 1024px) {
  .m-splash-underlay { position: absolute; z-index: 400; top: calc(var(--top-position)*1px); width: 100%; height: calc(var(--vh, 1vh)*99); pointer-events: none; }
  .m-splash-underlay::before { content: ""; display: block; position: absolute; top: calc(100% - 1px); left: 0px; width: 100%; height: 15dvh; background-color: var(--c-black); transform-origin: 50% 0px; scale: 1; }
  .-t-m-splash-enter-active::before { transition: scale 1.2s var(--f-cubic); }
  .-t-m-splash-leave-active::before { transition-property: ; transition-duration: ; transition-timing-function: ; transition-behavior: ; transition-delay: 0.3s; }
  .-t-m-splash-enter-from::before, .-t-m-splash-leave-to::before { scale: 1 0; }
}

.-t-page-enter-active { pointer-events: none; position: absolute; inset: 0px; opacity: 0; }

.-t-page-enter-active, .-t-page-leave-active { transition-duration: 0.9s; }
