@charset "utf-8";

h1, h2, h3, h4, h5, h6, p { margin: 0px; }

ol, ol *, ul, ul * { margin: 0px; padding: 0px; list-style-type: none; }

hr { background-color: rgba(var(--c-white),.1); height: 1px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; }

input, textarea { display: block; padding: 0.4rem; font-size: 16px; background-color: transparent; box-sizing: border-box; margin: 0px; color: var(--c-black); cursor: text; border-radius: 0.2rem; font-family: var(--font); font-feature-settings: "dlig", "ss03", "ss08"; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; box-shadow: inset 0 0 0 2px var(--c-black); }

@media (min-width: 1024px) {
  input, textarea { font-size: var(--body-font-size); display: inline-block; }
}

input:-internal-autofill-selected, input:-webkit-autofill, input:-webkit-autofill:focus, input:-webkit-autofill:hover, select:-webkit-autofill, select:-webkit-autofill:focus, select:-webkit-autofill:hover, textarea:-webkit-autofill, textarea:-webkit-autofill:focus, textarea:-webkit-autofill:hover { box-shadow: 0 0 0 1000px var(--c-black) inset; background-color: var(--c-black) !important; background-image: none !important; color: var(--c-white) !important; }

input:-webkit-autofill { -webkit-text-fill-color: var(--c-white) !important; }

input::placeholder, textarea::placeholder { color: var(--c-purple); opacity: 1; }

input[disabled]::placeholder, textarea[disabled]::placeholder { color: var(--c-purple); opacity: 0; }

input:focus, textarea:focus { outline: none; }

input:focus, input:hover, textarea:focus, textarea:hover { box-shadow: inset 0 0 0 2px var(--c-black),0 0 0 1px var(--c-black); }

input.-naked, textarea.-naked { box-shadow: none; }

button { font-family: var(--font); font-size: var(--body-font-size); line-height: var(--body-line-height,1.2); color: var(--c-white); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; margin: 0px; padding: 0px; background-color: transparent; cursor: pointer; touch-action: manipulation; }

button, button span { position: relative; display: block; }

figure { margin: 0px; }

img, svg, video { display: block; width: 100%; }

.-dn { display: none; }

@font-face { src: url("/fonts/katakana.woff") format("woff"), url("/fonts/katakana.woff2") format("woff2"); font-family: JP; font-style: normal; }

@font-face { src: url("/fonts/KHTeka-Regular.woff") format("woff"), url("/fonts/KHTeka-Regular.woff2") format("woff2"); font-family: KHTeka; font-style: normal; }

@font-face { src: url("/fonts/KHTekaMono-Regular.woff") format("woff"), url("/fonts/KHTekaMono-Regular.woff2") format("woff2"); font-family: KHTekaMono; font-style: normal; }

@font-face { font-family: fdsi; src: url("/fonts/fdsi.ttf?wud5tw") format("truetype"), url("/fonts/fdsi.woff?wud5tw") format("woff"); font-weight: 400; font-style: normal; font-display: block; }

