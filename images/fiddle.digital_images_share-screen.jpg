:root { --g-columns: 6; --columns: 6; --g-gap: .2rem; --g-margin: calc(var(--g-gap)*2); --col: calc(var(--vw, 1vw)*100/6 - var(--g-margin)*2/6 - var(--g-gap)*5/6); }

