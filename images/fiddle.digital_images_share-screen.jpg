.fdcm--toggle-container { position: relative; display: inline-block; width: calc(var(--fdcm--font-size)*2); height: calc(var(--fdcm--font-size)*1.25); }

.fdcm--toggle-container input { display: none; }

.fdcm--toggle { position: absolute; cursor: pointer; inset: 0px; background-color: var(--fdcm--ui-secondary,var(--fdcm--ui-secondary-default)); transition: background-color .15s var(--fdcm--timing-function); border-radius: calc(var(--fdcm--font-size)*1); }

.fdcm--toggle::before { content: ""; display: block; position: absolute; top: calc(var(--fdcm--font-size)*.125); left: calc(var(--fdcm--font-size)*.125); height: calc(var(--fdcm--font-size)*1); width: calc(var(--fdcm--font-size)*1); background-color: var(--sc-toggle-knob-bg,var(--sc-cookie-category-block-bg,#101214)); border-radius: 50%; transition: transform .3s var(--fdcm--timing-function); }

.fdcm--toggle-container input:checked + .fdcm--toggle::before { background-color: var(--fdcm--ui-highlight-main,var(--fdcm--ui-highlight-main-default)); transform: translate(calc(var(--fdcm--font-size)*.75)); }

.fdcm--toggle-label { cursor: pointer; margin-left: 0.5rem; }

.fdcm--toggle-label::selection { background-color: transparent; }

.fdcm--icon-dropdown { position: relative; padding: calc(var(--fdcm--font-size)/1); }

.fdcm--icon-dropdown::before { content: ""; display: block; border-top-color: ; border-top-style: ; border-right-color: ; border-right-style: ; border-bottom-color: ; border-bottom-style: ; border-left-color: ; border-left-style: ; border-image-source: ; border-image-slice: ; border-image-width: ; border-image-outset: ; border-image-repeat: ; border-width: 0 calc(var(--fdcm--font-size)/7) calc(var(--fdcm--font-size)/7) 0; aspect-ratio: 1 / 1; padding: calc(var(--fdcm--font-size)/6); transform: rotate(45deg); }

.fdcm--settings-item.-opened .fdcm--icon-dropdown { transform: scaleY(-1); }

.fdcm--item-conent { position: relative; display: none; padding: calc(var(--fdcm--font-size)/1); }

.fdcm--item-conent::before { content: ""; display: block; position: absolute; top: 0px; left: 0px; width: 100%; height: 100%; background-color: var(--fdcm--ui-secondary,var(--fdcm--ui-secondary-default)); opacity: 0.2; border-radius: 0 0 calc(var(--fdcm--border-radius, var(--fdcm--border-radius-default))*1) calc(var(--fdcm--border-radius, var(--fdcm--border-radius-default))*1); }

.fdcm--item-conent p { position: relative; font-size: clamp(12px,var(--fdcm--font-size)/var(--fdcm--font-step),var(--fdcm--font-size)/var(--fdcm--font-step)); }

.fdcm--settings-item.-opened .fdcm--item-conent { display: block; }

