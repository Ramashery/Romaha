hr { background-color: rgba(var(--c-white),.1); height: 1px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; }

input, textarea { display: block; padding: 0.4rem; font-size: 16px; background-color: transparent; box-sizing: border-box; margin: 0px; color: var(--c-black); cursor: text; border-radius: 0.2rem; font-family: var(--font); font-feature-settings: "dlig", "ss03", "ss08"; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; box-shadow: inset 0 0 0 2px var(--c-black); }

