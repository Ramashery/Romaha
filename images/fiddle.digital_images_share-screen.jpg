@charset "utf-8";

.-w[data-v-4f043ceb] { position: relative; box-sizing: border-box; display: grid; grid-template-rows: repeat(var(--rows,1),var(--rows-height,auto)); grid-template-columns: repeat(var(--g-columns,12),1fr); column-gap: var(--g-gap); margin: 0 var(--g-margin); }

.-w[data-v-4f043ceb] > * { --left: 1; --top: 1; --width: 1; --height: 1; grid-row-start: var(--top,1); grid-row-end: calc(var(--top, 1) + var(--height, 1)); grid-column-start: var(--left,1); grid-column-end: calc(var(--left, 1) + var(--width, 1)); }

.video-wrap.-fit[data-v-cb76e684] { position: relative; display: flex; justify-content: center; align-items: center; pointer-events: none; overflow: hidden; }

.video-wrap.-fit video[data-v-cb76e684] { position: relative; width: 100%; height: 100%; object-fit: cover; }

.media[data-v-250e5163] { position: relative; transform: translateZ(0px); background-color: var(--c-white); overflow: hidden; }

.media[data-v-250e5163]::before { content: ""; display: block; width: 100%; padding-bottom: 100%; }

.media figure[data-v-250e5163] { display: none; }

.media .video-wrap[data-v-250e5163] { position: absolute; top: 0px; left: 0px; width: 100%; height: 100%; pointer-events: all; }

@media (min-width: 1024px) {
  .media figure[data-v-250e5163] { display: block; overflow: hidden; }
  .media figure[data-v-250e5163], .media figure img[data-v-250e5163] { position: absolute; top: 0px; left: 0px; width: 100%; height: 100%; }
  .media figure img[data-v-250e5163] { object-fit: cover; visibility: hidden; }
  .media figure img.-active[data-v-250e5163] { visibility: visible; }
  .media .video-wrap[data-v-250e5163] { transform-origin: 95% 5%; transform: scale(1); transition: transform .6s var(--f-cubic); }
  .media.-slideshow .video-wrap[data-v-250e5163] { overflow: hidden; transform: scale(0.4); transition: transform .45s var(--f-cubic); }
}
