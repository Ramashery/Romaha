.fdcm--icon-close::before { content: "×"; display: block; font-size: calc(var(--fdcm--font-size)*var(--fdcm--font-step)*var(--fdcm--font-step)); aspect-ratio: 1 / 1; width: calc(var(--fdcm--font-size)*var(--fdcm--font-step)*var(--fdcm--font-step)); line-height: calc(var(--fdcm--font-size)*var(--fdcm--font-step)*var(--fdcm--font-step)); }

.fdcm--body { max-height: 60vh; overflow-y: scroll; }

.fdcm--body-scroll { padding: 1rem 1rem 0px; }

