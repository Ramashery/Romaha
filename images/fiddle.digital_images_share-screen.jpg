input:focus, input:hover, textarea:focus, textarea:hover { box-shadow: inset 0 0 0 2px var(--c-black),0 0 0 1px var(--c-black); }

input.-naked, textarea.-naked { box-shadow: none; }

button { font-family: var(--font); font-size: var(--body-font-size); line-height: var(--body-line-height,1.2); color: var(--c-white); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; margin: 0px; padding: 0px; background-color: transparent; cursor: pointer; touch-action: manipulation; }

button, button span { position: relative; display: block; }

figure { margin: 0px; }

img, svg, video { display: block; width: 100%; }

.-dn { display: none; }

