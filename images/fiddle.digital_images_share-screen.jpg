.fdcm--item-head { cursor: pointer; display: flex; justify-content: space-between; align-items: center; position: relative; color: var(--sc-button-secondary-text,#bdaeb9); border-bottom: 1px solid var(--fdcm--ui-secondary,var(--fdcm--ui-secondary-default)); }

.fdcm--item-head::before { content: ""; display: block; position: absolute; top: 0px; left: 0px; width: 100%; height: 100%; background-color: var(--fdcm--ui-secondary,var(--fdcm--ui-secondary-default)); opacity: 0.2; border-radius: calc(var(--fdcm--border-radius, var(--fdcm--border-radius-default))*1) calc(var(--fdcm--border-radius, var(--fdcm--border-radius-default))*1) 0 0; transform: scaleY(0); transform-origin: 50% 100%; }

.fdcm--settings-item.-opened .fdcm--item-head::before { transform: scale(1); }

