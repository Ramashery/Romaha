------MultipartBoundary--uJGqTESWbPQ8j7jlpcfzY11O05EitopDhnhba8poQF----
Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: https://fiddle.digital/_nuxt/connect.CvoUPcsg.css

@charset "utf-8";

.grid[data-v-8628728f] { contain: paint; background-color: transparent; pointer-events: none; }

.grid[data-v-8628728f], .grid[data-v-8628728f] > * { position: relative; }

.grid[data-v-8628728f]::before { content: ""; position: absolute; top: 0px; left: 0px; width: 100%; height: 100%; display: block; background-color: var(--c-black); scale: 1 0; transform-origin: 50% 0px; transition: scale .6s var(--f-cubic-in); }

.grid .-w[data-v-8628728f] { position: relative; min-height: calc(var(--vh, 1vh)*40); }

.grid .-w .-gc[data-v-8628728f] { --width: 6; margin-top: var(--h4); margin-bottom: var(--h5); color: var(--c-white); background-image: linear-gradient(to right,var(--c-grey-dark) 0,var(--c-grey-dark) 100%),linear-gradient(to right,var(--c-grey-dark) 0,var(--c-grey-dark) 100%); background-position: 0px 0px, 0px 100%; background-repeat: no-repeat, no-repeat; background-size: 0px 1px, 0px 1px; transition: background-size .9s var(--f-cubic); }

.grid .-w .-gc .-h6[data-v-8628728f] { --left: 2; --width: 3; }

.grid .-w .-gc .-p[data-v-8628728f] { --top: 2; --width: 2; margin-top: auto; }

.grid .-w .-gc svg[data-v-8628728f] { --top: 2; --left: 6; margin-top: auto; fill: var(--c-white); width: 1.2rem; }

html.-loaded.-ready .grid[data-v-8628728f]::before { scale: 1; transition: scale .9s var(--f-cubic-in); }

html.-loaded.-ready .grid .-w .-gc[data-v-8628728f] { background-size: 100% 1px, 100% 1px; transition-delay: 0.6s; }

@media (min-width: 1024px) {
  .grid .-w[data-v-8628728f] { min-height: calc(var(--vh, 1vh)*50); }
  .grid .-w .-gc[data-v-8628728f] { --width: 14; margin-top: calc(var(--g-gap)*2 + 4.6rem); margin-bottom: calc(var(--g-gap)*2 + 4.6rem); }
  .grid .-w .-gc .-h6[data-v-8628728f] { --left: 7; }
  .grid .-w .-gc svg[data-v-8628728f] { --left: 14; }
  html.-loaded.-ready .grid[data-v-8628728f]::before { transition: scale 1.2s var(--f-cubic-in); }
}

.option[data-v-b9a594d8] { position: relative; mask: url("../images/r14.svg"); background-color: var(--c-berry); padding: calc(var(--g-gap)*2) calc(var(--g-gap)*2) calc(var(--g-gap)*2) calc(var(--g-gap)*3); cursor: pointer; display: flex; gap: 0.2rem; }

.option .bg[data-v-b9a594d8] { inset: 2px; background-color: var(--c-purple); overflow: hidden; }

.option .bg[data-v-b9a594d8], .option .bg[data-v-b9a594d8]::before { position: absolute; display: block; mask: url("../images/r12.svg"); }

.option .bg[data-v-b9a594d8]::before { content: ""; top: 0px; left: 0px; width: 100%; height: 100%; background-color: var(--c-black); transform: translate3d(0px, 100%, 0px); transition: transform .3s var(--f-cubic); }

.option .title[data-v-b9a594d8] { position: relative; }

.option.-check[data-v-b9a594d8]::after, .option.-radio[data-v-b9a594d8]::after { align-self: flex-end; content: ""; position: relative; display: block; width: 3px; height: 3px; border: 1px solid var(--c-berry); }

.option.-radio[data-v-b9a594d8]::after { border-radius: 50%; }

.option.-active[data-v-b9a594d8] { cursor: default; }

.option.-active[data-v-b9a594d8]::after { border: 1px solid var(--c-grey-dark); background-color: var(--c-grey-dark); }

